AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_PATH=../../data/studio
PORT=3011
PUBLIC_API_URL=http://127.0.0.1:3011
ALLOWED_ORIGINS=http://127.0.0.1:5178
AUTH_MODE=mock
MOCK_USER_ID=user_local_development
AUTH_PROJECT_SECRET=replace-in-production
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
API_RATE_LIMIT_PER_MINUTE=120
USER_STORAGE_LIMIT_MB=500
USER_SOURCE_LIMIT=50
USER_DAILY_AI_LIMIT=50
USAGE_DATABASE_PATH=../../data/studio/daily-usage.json

# Production metadata database. Leave empty in local development.
DATABASE_URL=

# Qwen / DashScope OCR and summaries.
DASHSCOPE_API_KEY=
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_VISION_MODEL=qwen3.6-plus
# Optional fallback matching the current Case Hub Qwen setup.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_QWEN_MODEL=qwen/qwen2.5-vl-72b-instruct
SOURCE_WORKER_CONCURRENCY=2
AGENT_WORKER_CONCURRENCY=2
RESEARCH_WORKER_CONCURRENCY=1
PDF_OCR_MAX_PAGES=12

# Public web research. Fast uses Tavily basic search; Deep uses advanced search.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search

# Read-only Studio integration with Sci-Viz Case Hub. Use the same random key in both services.
CASE_HUB_API_URL=http://127.0.0.1:3001/api
CASE_HUB_STUDIO_KEY=

# Alibaba Cloud OSS. When absent, local development storage is used.
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
SOURCE_STORAGE_PATH=../../data/studio/objects

# AI image generation via OpenRouter. Set IMAGE_PROVIDER=openrouter to enable.
IMAGE_PROVIDER=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# Required in production. Use a long random value; changing it invalidates existing review links.
REVIEW_TOKEN_SECRET=
PUBLIC_WEB_URL=http://127.0.0.1:5178
