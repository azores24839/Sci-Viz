# Local settings. Relative data paths are relative to sci-viz-case-hub/.
CASE_HUB_DATA_DIR=.local-data
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=
JWT_SECRET=local-demo-only-not-for-production
STUDIO_SERVICE_KEY=local-demo-service-only-not-for-production
ALLOW_PUBLIC_REGISTRATION=false

# Optional: leave empty to browse the demo without calling paid AI/OCR services.
VISION_API_URL=https://openrouter.ai/api/v1/chat/completions
VISION_MODEL=
OCR_VISION_MODEL=
VISION_PROVIDER=openrouter
VISION_API_KEY=
OPENROUTER_API_KEY=
OCR_API_URL=
OCR_API_KEY=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
