# Docker image and local reverse-proxy binding
# Use the immutable Git SHA tag produced by CI, never "latest" in production.
CASE_HUB_IMAGE_TAG=replace-with-tested-git-sha
CASE_HUB_BIND_IP=127.0.0.1
CASE_HUB_PORT=3001
CASE_HUB_DATA_DIR=/srv/case-hub/data
CASE_HUB_CPUS=1.5
CASE_HUB_MEMORY_LIMIT=2g
# Keep false during normal operation. Set true only for a reviewed first-time initialization,
# then return it to false before the next deployment.
CASE_HUB_ALLOW_DATABASE_INITIALIZATION=false

# Required application security settings
# Use the actual HTTPS origin, without a path or trailing slash.
# These two distinct secrets are required even when Studio is not deployed.
# JWT_SECRET also encrypts saved personal API keys. Preserve a compliant existing
# secret on migration, or have each owner re-enter their API key after rotation.
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://case-hub.example.edu.cn
STUDIO_SERVICE_KEY=replace-with-a-different-long-random-secret

# Optional OSS integration
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=replace-with-your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Optional AI/OCR providers; keep secrets only in the private online.env.
VISION_API_URL=https://openrouter.ai/api/v1/chat/completions
VISION_MODEL=
OCR_VISION_MODEL=
VISION_PROVIDER=openrouter
VISION_API_KEY=
OPENROUTER_API_KEY=
OCR_API_URL=
OCR_API_KEY=
OSS_PUBLIC_BASE_URL=
