# Docker image and local reverse-proxy binding
# Use the immutable Git SHA tag produced by CI, never "latest" in production.
CASE_HUB_IMAGE_TAG=replace-with-tested-git-sha
CASE_HUB_BIND_IP=127.0.0.1
CASE_HUB_PORT=3001
CASE_HUB_DATA_DIR=./data
CASE_HUB_CPUS=1.5
CASE_HUB_MEMORY_LIMIT=2g
# Keep false during normal operation. Set true only for a reviewed first-time initialization,
# then return it to false before the next deployment.
CASE_HUB_ALLOW_DATABASE_INITIALIZATION=false

# Required application security settings
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-production-domain.example
STUDIO_SERVICE_KEY=replace-with-a-different-long-random-secret

# Optional OSS integration
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=replace-with-your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
