generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model VisualCase {
  id        String   @id @default(uuid())
  title     String   @default("")

  sourceUrl      String @default("")
  sourceDomain   String @default("")
  pageTitle      String @default("")
  caseTitle      String @default("")

  imageUrl      String @default("")
  imagePath     String @default("")
  thumbnailPath String @default("")
  imageHash     String @default("")

  videoUrl       String @default("")
  videoPlatform  String @default("")
  videoDuration  Int    @default(0)

  contextText String @default("")
  ocrText     String @default("")
  ocrProcessedAt DateTime?
  captureType String @default("image")
  userHint    String @default("")
  collectionScore Int @default(0)
  collectionReasons String @default("")

  mediaType    String @default("")
  contentType  String @default("")
  discipline   String @default("")
  technicalMethod  String @default("")
  composition  String @default("")
  colorTone    String @default("")
  useCase      String @default("")
  functionalPurpose  String @default("")   // 功能用途：记录|解释|数据|展示|传播|交互
  distributionMedium String @default("")   // 传播媒介：静图|动图|视频|图组|交互|实体
  mediaSubType       String @default("")   // 技术手段子分类
  contentSubType     String @default("")   // 内容对象子分类
  aiSummary    String @default("")
  borrowablePoints String @default("")
  riskNotes    String @default("")
  confidence   Float  @default(0.0)

  reviewStatus String @default("pending_ai_analysis")
  rating       Int    @default(0)
  manualNotes  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([imageHash])
  @@index([sourceUrl])
  @@index([sourceDomain])
}

model OcrJob {
  id               String    @id @default(uuid())
  status           String    @default("queued")
  stage            String    @default("preparing")
  activeKey        String?   @unique
  caseIdsJson      String    @default("[]")
  nextIndex        Int       @default(0)
  totalCount       Int       @default(0)
  processedCount   Int       @default(0)
  updatedCount     Int       @default(0)
  skippedCount     Int       @default(0)
  failedCount      Int       @default(0)
  currentCaseId    String    @default("")
  currentCaseTitle String    @default("")
  currentMethod    String    @default("")
  errorsJson       String    @default("[]")
  backupPath       String    @default("")
  error            String    @default("")
  cancelRequested  Boolean   @default(false)
  ownerUserId      String    @default("")
  startedAt        DateTime?
  heartbeatAt      DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AnalysisJob {
  id               String    @id @default(uuid())
  status           String    @default("queued")
  stage            String    @default("preparing")
  activeKey        String?   @unique
  caseIdsJson      String    @default("[]")
  nextIndex        Int       @default(0)
  totalCount       Int       @default(0)
  processedCount   Int       @default(0)
  analyzedCount    Int       @default(0)
  skippedCount     Int       @default(0)
  failedCount      Int       @default(0)
  currentCaseId    String    @default("")
  currentCaseTitle String    @default("")
  errorsJson       String    @default("[]")
  backupPath       String    @default("")
  error            String    @default("")
  cancelRequested  Boolean   @default(false)
  ownerUserId      String    @default("")
  startedAt        DateTime?
  heartbeatAt      DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model CrawlSource {
  id           Int      @id @default(autoincrement())
  name         String   @default("")
  url          String   @default("")
  category     String   @default("")
  sourceType   String   @default("")
  adapterType  String   @default("static_html")
  crawlStatus  String   @default("active_static")
  crawlTier    String   @default("B")
  lastDiagnosis String  @default("")
  visualValue  String   @default("")
  strategyHint String   @default("")
  enabled      Boolean  @default(true)
  scheduleEnabled Boolean @default(false)
  scheduleIntervalHours Int @default(168)
  nextRunAt    DateTime?
  lastSuccessAt DateTime?
  healthStatus String   @default("unknown")
  configJson   String   @default("{}")
  cursorJson   String   @default("{}")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs CrawlJob[]
  items CrawlItem[]
}

model CrawlJob {
  id             Int      @id @default(autoincrement())
  sourceId       Int
  status         String   @default("pending")
  discoveredUrls String   @default("[]")
  crawledUrls    String   @default("[]")
  totalCount     Int      @default(0)
  crawledCount   Int      @default(0)
  newCases       Int      @default(0)
  error          String   @default("")
  warning        String   @default("")
  mode           String   @default("incremental")
  trigger        String   @default("manual")
  attempt        Int      @default(0)
  pagesVisited   Int      @default(0)
  articlesWithImages Int  @default(0)
  candidateImages Int     @default(0)
  downloadedImages Int    @default(0)
  duplicateImages Int     @default(0)
  failedPages    Int      @default(0)
  failedImages   Int      @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  heartbeatAt    DateTime?
  manifestPath   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  items  CrawlItem[]

  @@index([sourceId])
}

model CrawlItem {
  id               Int      @id @default(autoincrement())
  jobId            Int
  sourceId         Int
  url              String
  status           String   @default("pending")
  attempts         Int      @default(0)
  error            String   @default("")
  foundImages      Int      @default(0)
  downloadedImages Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  job    CrawlJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([jobId, url])
  @@index([sourceId, url])
  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiCredential UserApiCredential?
}

model UserApiCredential {
  userId       String   @id
  provider     String   @default("openrouter")
  endpoint     String
  model        String
  encryptedKey String
  keyIv        String
  keyTag       String
  keyHint      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollectionKpi {
  id          Int      @id @default(autoincrement())
  dimension   String
  category    String
  targetCount Int
  priority    Int      @default(50)
  enabled     Boolean  @default(true)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dimension, category])
  @@index([dimension])
  @@index([enabled])
}
