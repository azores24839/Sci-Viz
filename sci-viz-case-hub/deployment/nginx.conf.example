# Replace hostname and certificate paths with the approved campus HTTPS endpoint.
server {
    listen 80;
    server_name case-hub.example.edu.cn;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name case-hub.example.edu.cn;
    ssl_certificate /etc/ssl/case-hub/fullchain.pem;
    ssl_certificate_key /etc/ssl/case-hub/privkey.pem;
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
