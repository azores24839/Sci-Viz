CASE_HUB_COMPOSE_DIR=/srv/case-hub
CASE_HUB_DATA_DIR=/srv/case-hub/data
CASE_HUB_SNAPSHOT_DIR=/srv/case-hub-snapshots
# Enable only after disabling every writer outside the case-hub container.
CASE_HUB_WRITERS_MANAGED=false
CASE_HUB_SNAPSHOT_KEEP=7
# Private SSH destination; provision its SSH key and pinned known_hosts separately.
CASE_HUB_OFFSITE_DEST=
